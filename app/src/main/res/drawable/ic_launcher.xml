<?xml version="1.0" encoding="utf-8"?>
<!-- The unmasked icon. A dial and a needle: the face of any meter that ever told anyone how fast.

     Drawn to the five rules measured off the owner's own chanterelle in
     kinokocho/tools/make-art.py, which is what every icon in this shop with any character
     is built on: a thin line, one weight all through, few strokes, crooked rather than
     symmetrical, and no solid black except droplets.

     An earlier version of this mark was constructed instead of drawn - heavy strokes,
     exact circles, perfect symmetry, filled shapes. It broke four of those five, and read
     as a stock utility icon rather than as one of these.

     Everything sits inside the central 66 units the launcher mask is certain to keep. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:fillColor="#FFFFFF" android:pathData="M0,0h108v108h-108z" />

    <!-- the dial: one sweep, ends not quite level, apex a little left of centre -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M30.6,71.2 C32.8,48.4 41.0,34.2 54.5,33.4 C68.1,32.7 76.4,46.8 78.2,68.8" />

    <!-- the needle: one line, bowed the way a hand bows a long stroke -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M53.4,60.4 C58.6,54.6 64.2,47.4 70.0,40.2" />

    <!-- the pivot: a droplet, the one fill a page of thin lines can carry -->
    <path android:fillColor="#000000"
        android:pathData="M51.5,57.8 A2.5,2.4 0 1 0 51.6,57.8 Z" />
</vector>
