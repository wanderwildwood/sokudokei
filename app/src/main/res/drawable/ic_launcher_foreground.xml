<?xml version="1.0" encoding="utf-8"?>
<!-- A dial and a needle: the face of any meter that ever told anyone how fast.

     Drawn rather than ruled. The arc thins where a brush would lift and the needle is
     not quite straight, because this is a mark and not an interface - the one place in
     this app where an irregular line belongs. Everything else on screen is hard-edged.

     The launcher masks this to a shape of its choosing and only the central 66 of these
     108 units are certain to survive, so the whole gauge sits inside that circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the dial, open at the bottom the way a gauge is -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M29.6,67.4 A26,26 0 0 1 78.6,66.4" />

    <!-- the needle, resting a little past halfway as a needle at speed does -->
    <path
        android:fillColor="#000000"
        android:pathData="M51.4,59.9 C52.6,58.6 55.4,56.9 56.7,56.1 C60.4,50.6 65.1,43.2 68.2,37.9 C64.6,43.6 58.9,51.4 55.2,56.6 C54.1,57.4 52.3,58.9 51.4,59.9 Z" />

    <!-- the pivot -->
    <path
        android:fillColor="#000000"
        android:pathData="M54,52.6 C57.1,52.5 59.6,55 59.5,58.1 C59.4,61.1 56.9,63.5 53.9,63.4 C50.9,63.3 48.5,60.8 48.6,57.8 C48.7,54.9 51.1,52.6 54,52.6 Z" />
</vector>
